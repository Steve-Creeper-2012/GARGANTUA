#!/usr/bin/env bash
# ===========================================================================
# GARGANTUA v1 — 启动.command（项目根目录，中文名）：macOS 双击启动
# ---------------------------------------------------------------------------
# 薄包装：中文名启动入口，直接调用 launcher/start-server.sh
# （含启动前 GitHub Release 检查、环境安装、拉起 server）。
# 关闭终端窗口即触发 server 的收尾（窗口/服务依次退出）。
# ===========================================================================
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR" || exit 1
exec "./launcher/start-server.sh" "$@"
