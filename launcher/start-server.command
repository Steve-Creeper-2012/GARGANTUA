#!/usr/bin/env bash
# ===========================================================================
# GARGANTUA v1 — launcher/start-server.command：macOS 双击启动（兼容入口）
# ---------------------------------------------------------------------------
# 真正的双击入口在根目录 启动.command（它负责「交接成功后关掉终端窗口」）。
# 这里只是历史路径的兼容壳：转发给根目录 启动.command，避免两处各写一套
# 关窗逻辑导致行为分叉。
# ===========================================================================
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR/.." || exit 1
exec "./启动.command" "$@"
